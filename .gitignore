# ═══════════════════════════════════════════════════════════
# 🦀 RUST / CARGO
# ═══════════════════════════════════════════════════════════
/target/
**/*.rs.bk

# NOTE: Cargo.lock est CONSERVÉ pour les applications/jeux Rust
# afin de garantir des builds reproductibles sur toutes les machines.

# ═══════════════════════════════════════════════════════════
# 🛠️ IDE / ÉDITEURS
# ═══════════════════════════════════════════════════════════
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / IntelliJ
.idea/
*.iml

# ═══════════════════════════════════════════════════════════
# 🪟 SPÉCIFIQUE OS
# ═══════════════════════════════════════════════════════════
# Windows
Thumbs.db
desktop.ini
*.lnk
$RECYCLE.BIN/

# macOS
.DS_Store
._*

# Linux
*~

# ═══════════════════════════════════════════════════════════
# 🐛 DEBUG / PROFILING (MSVC/Windows)
# ═══════════════════════════════════════════════════════════
*.pdb
*.ilk
*.exp
*.profraw
*.profdata

# ═══════════════════════════════════════════════════════════
# 🔐 SECRETS & ENV
# ═══════════════════════════════════════════════════════════
.env
.env.*
!**/.env.example

# ═══════════════════════════════════════════════════════════
# 🧹 BEVY / RUST-ANALYZER (évite les fichiers fantômes)
# ═══════════════════════════════════════════════════════════
target/flycheck*/
*.flycheck*
target/

# ═══════════════════════════════════════════════════════════
# 🎨 ASSETS (NE PAS IGNORER - à versionner)
# ═══════════════════════════════════════════════════════════
# assets/  ← Cette ligne doit être COMMENTÉE ou SUPPRIMÉE
# !assets/ ← Ou utiliser ! pour forcer l'inclusion

# Mais ignorer les assets générés/temporaires :
assets/generated/
assets/*.tmp

# ═══════════════════════════════════════════════════════════
# 🤖 IA / RAG / PYTHON (Pour tes scripts et bases vectorielles)
# ═══════════════════════════════════════════════════════════
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/
*rag_db/
chroma/
db.sqlite3
*.pickle
rag_outputs/
# ═══════════════════════════════════════════════════════════
# 📂 DOCS / BACKUPS (Optionnel, selon tes préférences de versionnement)
# ═══════════════════════════════════════════════════════════
docs/gameplay/metiers/backup_old/
*.tmp
*.bak

*rag.py
questions_code.txt
*.err
*.blend1
*.blend